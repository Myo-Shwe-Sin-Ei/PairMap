    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/OutstandingQuality -->

    <owl:Class rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/OutstandingQuality">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/WineReview"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasScore"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">95</xsd:minInclusive>
                                    </rdf:Description>
                                    <rdf:Description>
                                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">100</xsd:maxInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/WineReview"/>
        <rdfs:comment>A wine quality scored between 95-100 points, classified as outstanding</rdfs:comment>
    </owl:Class>
    


