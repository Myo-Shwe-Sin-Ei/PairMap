<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/"
     xml:base="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:msse="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#">
    <owl:Ontology rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/">
        <dc:creator>Myo Shwe Sin Ei</dc:creator>
        <rdfs:label>Wine Quality Review Ontology</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#altlabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altlabel"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/contains -->

    <owl:ObjectProperty rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/contains">
        <owl:inverseOf rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/locatedIn"/>
        <rdfs:comment>relation between grape variety and wine</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasOrigin -->

    <owl:ObjectProperty rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasOrigin">
        <owl:inverseOf rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/isOriginOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/Wine"/>
        <rdfs:range rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/GeographicArea"/>
        <rdfs:comment>relation between wine region/ sub-region and wine</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasRated -->

    <owl:ObjectProperty rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasRated">
        <owl:inverseOf rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/ratedBy"/>
        <rdfs:domain rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/Taster"/>
        <rdfs:range rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/WineReview"/>
        <rdfs:comment>relation between review and taster</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasReview -->

    <owl:ObjectProperty rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasReview">
        <owl:inverseOf rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/reviewOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/Wine"/>
        <rdfs:range rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/WineReview"/>
        <rdfs:comment>relation between review and wine</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/isOriginOf -->

    <owl:ObjectProperty rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/isOriginOf">
        <rdfs:comment>relation between wine region/ sub-region and wine</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/locatedIn -->

    <owl:ObjectProperty rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/locatedIn">
        <rdfs:comment>relation between two geographic areas</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/madeFrom -->

    <owl:ObjectProperty rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/madeFrom">
        <owl:inverseOf rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/usedIn"/>
        <rdfs:domain rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/Wine"/>
        <rdfs:range rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/GrapeVariety"/>
        <rdfs:comment>relation between grape variety and wine</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/producedBy -->

    <owl:ObjectProperty rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/producedBy">
        <owl:inverseOf rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/produces"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/Wine"/>
        <rdfs:range rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/Winery"/>
        <rdfs:comment>relation between winery and wine</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/produces -->

    <owl:ObjectProperty rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/produces">
        <rdfs:comment>relation between winery and wine</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/ratedBy -->

    <owl:ObjectProperty rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/ratedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/WineReview"/>
        <rdfs:range rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/Taster"/>
        <rdfs:comment>relation between review and taster</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/reviewOf -->

    <owl:ObjectProperty rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/reviewOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:comment>relation between winery and wine</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/usedIn -->

    <owl:ObjectProperty rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/usedIn">
        <rdfs:comment>relation between grape variety and wine</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasDescription -->

    <owl:DatatypeProperty rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasDescription">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/WineReview"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>tasting note and description of the wine in the review</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasDesignation -->

    <owl:DatatypeProperty rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasDesignation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/Wine"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A specific name or label given to a wine by the winery</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasName -->

    <owl:DatatypeProperty rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasName">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/Taster"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>full name of the taster</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasPrice -->

    <owl:DatatypeProperty rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasPrice">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/Wine"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>price of wine in US currency</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasScore -->

    <owl:DatatypeProperty rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasScore">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/WineReview"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>score (points) rated to the wine on the scale of 80-100 in the review</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasTitle -->

    <owl:DatatypeProperty rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasTitle">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/Wine"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>full title of the wine as listed in the review</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasTwitter -->

    <owl:DatatypeProperty rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasTwitter">
        <rdfs:domain rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/Taster"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>twitter handle of the taster</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/BlendVariety -->

    <owl:Class rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/BlendVariety">
        <rdfs:subClassOf rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/GrapeVariety"/>
        <rdfs:comment>Two or more grape varieties combined</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/Country -->

    <owl:Class rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/Country">
        <rdfs:subClassOf rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/GeographicArea"/>
        <rdfs:comment>A country where wine is produced</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/ExcellentQuality -->

    <owl:Class rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/ExcellentQuality">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/WineReview"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasScore"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">90</xsd:minInclusive>
                                    </rdf:Description>
                                    <rdf:Description>
                                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">94</xsd:maxInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/WineReview"/>
        <rdfs:comment>A wine quality scored between 90-94 points, classified as excellent</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/GeographicArea -->

    <owl:Class rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/GeographicArea">
        <rdfs:comment>A geographic location of wine production</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/GoodQuality -->

    <owl:Class rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/GoodQuality">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/WineReview"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasScore"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">80</xsd:minInclusive>
                                    </rdf:Description>
                                    <rdf:Description>
                                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">89</xsd:maxInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/WineReview"/>
        <rdfs:comment>A wine quality scored between 80-89 points, classified as good</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/GrapeVariety -->

    <owl:Class rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/GrapeVariety">
        <rdfs:comment>A variety of grape used in wine making</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/HighPrice -->

    <owl:Class rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/HighPrice">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/Wine"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasPrice"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50</xsd:minExclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/Wine"/>
        <rdfs:comment>A wine priced over $50</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/LowPrice -->

    <owl:Class rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/LowPrice">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/Wine"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasPrice"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</xsd:maxExclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/Wine"/>
        <rdfs:comment>A wine priced under $15</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/MadeiraBlendVariety -->

    <owl:Class rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/MadeiraBlendVariety">
        <rdfs:subClassOf rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/BlendVariety"/>
        <rdfs:comment>Made from unique or unknown origin grape varities</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/MidPrice -->

    <owl:Class rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/MidPrice">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/Wine"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/hasPrice"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</xsd:minInclusive>
                                    </rdf:Description>
                                    <rdf:Description>
                                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50</xsd:maxInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/Wine"/>
        <rdfs:comment>A wine priced between $15 and $50</rdfs:comment>
    </owl:Class>
    


