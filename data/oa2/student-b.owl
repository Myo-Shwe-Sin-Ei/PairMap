    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/ReviewOfBaglioDiPianetto2007FicilignoWhiteSicilia -->

    <owl:NamedIndividual rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/ReviewOfBaglioDiPianetto2007FicilignoWhiteSicilia">
        <rdf:type rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/WineReview"/>
        <ratedBy rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/KerinOKeefe"/>
        <hasDescription>Delicate aromas recall white flower and citrus. The palate offers passion fruit, lime and white peach with a hint of mineral alongside bright acidity.</hasDescription>
        <hasScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">87</hasScore>
        <skos:altlabel>Review Of Baglio di Pianetto 2007 Ficiligno White Sicilia</skos:altlabel>
    </owl:NamedIndividual>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/ReviewOfHeinzEifel2013ShineGewürztraminerRheinhessen -->

    <owl:NamedIndividual rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/ReviewOfHeinzEifel2013ShineGewürztraminerRheinhessen">
        <rdf:type rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/WineReview"/>
        <ratedBy rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/AnnaLeeCIijima"/>
        <hasDescription>Savory drive thyme notes accent sunnier falvors of preserved peach in this brisk, off-dry wine. It&apos;s fruity and fresh, with an elegant, sprightly footprint.</hasDescription>
        <hasScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">87</hasScore>
        <skos:altlabel>Review of HeinzEifel 2013 Shine Gewürztraminer (Rheinhessen)</skos:altlabel>
    </owl:NamedIndividual>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/ReviewOfLouisMMartini2012CabernetSauvignonAlexanderValley -->

    <owl:NamedIndividual rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/ReviewOfLouisMMartini2012CabernetSauvignonAlexanderValley">
        <rdf:type rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/WineReview"/>
        <ratedBy rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/VirginieBoone"/>
        <hasDescription>Slightly reduced, this wine offers a chalky, tannic backbone to an otherwise juicy explosion of rich black cherry, the whole accented throughout by firm oak and cigar box.</hasDescription>
        <hasScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">87</hasScore>
        <skos:altlabel>Review Of Louis M. Martini 2012 Cabernet Sauvignon (Alexander Valley)</skos:altlabel>
    </owl:NamedIndividual>
    


    <!-- http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/ReviewOfTerreDiGiurfo2013BelsitoFrappatoVictoria -->

    <owl:NamedIndividual rdf:about="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/ReviewOfTerreDiGiurfo2013BelsitoFrappatoVictoria">
        <rdf:type rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/WineReview"/>
        <ratedBy rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/myo_shwe_sin_ei/KerinOKeefe"/>
        <hasDescription>Here&apos;s a bright, informal red that opens with aromas of candied berry, white pepper and savory herb that carry over to the palate. It&apos;s balanced with fresh acidity and soft tannins.</hasDescription>
        <hasScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">87</hasScore>
        <skos:altlabel>Review Of Terre Di Giurfo 2013 Belsito Frappato (Victoria)</skos:altlabel>
    </owl:NamedIndividual>
    


